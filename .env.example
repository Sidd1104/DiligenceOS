# ── DiligenceOS Production Environment Variable Template ──────
# Copy this file to .env or populate variables in host provider dashboard.
# NEVER commit real secret values to Git repositories.

# ── Database (Neon PostgreSQL with pgvector) ─────────────────
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/diligenceos?sslmode=require

# ── Queue & Cache (Upstash Redis) ────────────────────────────
REDIS_URL=rediss://default:password@xyz.upstash.io:6379

# ── Security & Authentication ────────────────────────────────
JWT_SECRET=your-random-32-character-secret-key
ALLOWED_ORIGINS=https://diligenceos.vercel.app,https://diligenceos-web.vercel.app
COOKIE_SECURE=True
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# ── AI Engines ───────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIzaSy...
VOYAGE_API_KEY=pa-...

# ── AWS S3 Document Storage ──────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=sidd-diligenceos-documents-451432063365-ap-south-1-an
AWS_REGION=ap-south-1

# ── Frontend Production API Target ───────────────────────────
NEXT_PUBLIC_API_URL=https://diligenceos-api.onrender.com
